      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0f083677-9702-4be7-85d5-ea26be402db4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="sample_ca"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C4C2137B-E5BB-42B0-86E1-DFB5AC6226C1}"
          SQLTask:SqlStatementSource="DELETE c&#xA;FROM dbo.SA_Casualty AS c&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dbo.SA_Collision AS col&#xA;    WHERE col.collision_index = c.collision_index&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\sample_col"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{b28ddcf3-0ec4-4891-942b-fcdb9c970a38}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="sample_col"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C4C2137B-E5BB-42B0-86E1-DFB5AC6226C1}"
          SQLTask:SqlStatementSource="DELETE FROM dbo.SA_Collision&#xA;WHERE collision_index NOT IN (&#xA;    SELECT TOP (900000) collision_index&#xA;    FROM dbo.SA_Collision&#xA;    ORDER BY collision_index&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\sample_vi"
